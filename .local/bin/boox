#!/usr/bin/env bash
# boox - check, browse and send files to a Boox e-reader over USB (MTP).
# Requires: brew install libmtp
set -euo pipefail

# The Boox exposes the same storage twice ("Internal shared storage" and "disk"), and
# lists your books under "disk". We read both and send to "disk" when it exists.
PREFERRED_STORAGE="disk"

usage() {
  cat <<'EOF'
Usage:
  boox                       Show whether the Boox is connected, plus its top-level folders
  boox ls [FOLDER]           List subfolders and files in FOLDER (e.g. Books, Books/tryread)
  boox send FILE... [-t FOLDER]
                             Copy file(s) to FOLDER on the Boox (default: Books)

Tip: unlock the Boox and close OpenMTP/Android File Transfer first - only one app
can talk to the device at a time.
EOF
}

die() { echo "boox: $*" >&2; exit 1; }

command -v mtp-folders >/dev/null || die "libmtp not installed. Run: brew install libmtp"

# Folder IDs change every time the device reconnects, so always look them up by name.
# Prints "ID<TAB>storage<TAB>path/to/folder" for every folder on every storage.
folder_table() {
  mtp-folders 2>/dev/null | awk '
    /^Storage: / { storage = substr($0, 10); next }
    /^[0-9]+\t/ {
      id = $0; sub(/\t.*/, "", id)
      rest = $0; sub(/^[0-9]+\t/, "", rest)
      match(rest, /^ */); depth = RLENGTH / 2
      name = substr(rest, RLENGTH + 1)
      path[depth] = name
      p = path[0]; for (i = 1; i <= depth; i++) p = p "/" path[i]
      print id "\t" storage "\t" p
    }'
}

# Prints "parentID<TAB>size<TAB>filename" for every file on the device.
file_table() {
  mtp-files 2>/dev/null | awk '
    /^   Filename: / { name = substr($0, 14) }
    /^   File size / { size = $3 }
    /^   Parent ID: / { print $3 "\t" size "\t" name }'
}

# All IDs (one per storage) for a folder path, case-insensitive.
folder_ids() {
  local want="${1%/}"
  printf '%s\n' "$FOLDERS" | awk -F'\t' -v w="$want" 'tolower($3) == tolower(w) { print $1 }'
}

# The ID to send into: the preferred storage if it has the folder, else the first match.
send_id() {
  local want="${1%/}"
  printf '%s\n' "$FOLDERS" | awk -F'\t' -v w="$want" -v ps="$PREFERRED_STORAGE" '
    tolower($3) == tolower(w) { if (!first) first = $1; if ($2 == ps) pref = $1 }
    END { print (pref ? pref : first) }'
}

# Real path of a folder as named on the device (fixes the user's capitalisation).
folder_path() {
  printf '%s\n' "$FOLDERS" | awk -F'\t' -v w="${1%/}" 'tolower($3) == tolower(w) { print $3; exit }'
}

# Unique filenames (with sizes) inside any of the given folder IDs.
files_in() {
  file_table | awk -F'\t' -v ids=" $* " 'index(ids, " " $1 " ") { print $2 "\t" $3 }' | sort -t$'\t' -k2 -fu
}

human() { awk -v b="$1" 'BEGIN { split("B KB MB GB", u); i = 1; while (b >= 1024 && i < 4) { b /= 1024; i++ } printf (i == 1 ? "%d %s" : "%.1f %s"), b, u[i] }'; }

check_connected() {
  local info
  info=$(mtp-detect 2>&1 | grep -E "^\s+Model:" | head -1 | sed 's/^ *Model: *//') || true
  if [[ -z "$info" ]]; then
    if system_profiler SPUSBDataType 2>/dev/null | grep -qi "ONYX"; then
      die "Boox is plugged in but not responding. Unlock it, close OpenMTP/Android File Transfer, then retry."
    fi
    die "No Boox found. Check the cable, and on the Boox pick 'File transfer (MTP)' in the USB popup."
  fi
  echo "Connected: Boox $info"
}

subfolders() {
  local prefix="$1"
  printf '%s\n' "$FOLDERS" | awk -F'\t' -v p="$prefix" '{
      rel = $3
      if (p != "") { if (index(tolower(rel), tolower(p) "/") != 1) next; rel = substr(rel, length(p) + 2) }
      if (rel !~ /\//) print rel
    }' | awk '!seen[$0]++'
}

cmd_status() {
  check_connected
  FOLDERS=$(folder_table)
  echo
  echo "Top-level folders:"
  subfolders "" | sed 's/^/  /'
  echo
  echo "Books usually go in: Books   (try: boox ls Books)"
}

cmd_ls() {
  local target="${1:-}"
  FOLDERS=$(folder_table)
  [[ -n "$FOLDERS" ]] || die "Could not read the Boox. Is it connected and unlocked?"
  if [[ -z "$target" ]]; then
    subfolders "" | sed 's|$|/|'
    return
  fi
  local ids
  ids=$(folder_ids "$target" | tr '\n' ' ')
  [[ -n "${ids// }" ]] || die "No folder '$target'. Run 'boox ls' to see what exists."
  subfolders "$(folder_path "$target")" | sed 's|^\(.*\)$|  \1/|'
  files_in $ids | while IFS=$'\t' read -r size name; do
    printf '  %-60s %10s\n' "$name" "$(human "$size")"
  done
}

cmd_send() {
  local dest="Books" files=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -t|--to) dest="${2:?missing folder after $1}"; shift 2 ;;
      *) files+=("$1"); shift ;;
    esac
  done
  [[ ${#files[@]} -gt 0 ]] || { usage; exit 1; }
  for f in "${files[@]}"; do [[ -f "$f" ]] || die "Not a file: $f"; done

  FOLDERS=$(folder_table)
  [[ -n "$FOLDERS" ]] || die "Could not read the Boox. Is it connected and unlocked?"
  local id
  id=$(send_id "$dest")
  [[ -n "$id" ]] || die "No folder '$dest' on the Boox. Run 'boox ls' to see what exists."
  dest=$(folder_path "$dest")

  local existing
  existing=$(files_in $(folder_ids "$dest") | cut -f2)
  for f in "${files[@]}"; do
    local name; name=$(basename "$f")
    if grep -qixF "$name" <<<"$existing"; then
      echo "Skipped $name - already in $dest"
      continue
    fi
    printf 'Sending %s -> %s ... ' "$name" "$dest"
    if mtp-sendfile "$f" "$id" >/dev/null 2>&1; then echo "done"; else echo "FAILED"; fi
  done
}

case "${1:-}" in
  ""|status) cmd_status ;;
  ls) shift; cmd_ls "$@" ;;
  send) shift; cmd_send "$@" ;;
  -h|--help|help) usage ;;
  *) usage; exit 1 ;;
esac
